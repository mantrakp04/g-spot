{
  "name": "g-spot-cli",
  "version": "0.0.3",
  "description": "CLI launcher for the g-spot local-first web and server app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantrakp04/g-spot.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/mantrakp04/g-spot#readme",
  "bugs": {
    "url": "https://github.com/mantrakp04/g-spot/issues"
  },
  "type": "module",
  "bin": {
    "g-spot": "dist/index.js",
    "g-spot-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "build": "bun scripts/build-package.ts",
    "start": "bun run dist/index.js",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@g-spot/db": "workspace:*",
    "@g-spot/config": "workspace:*",
    "@types/bun": "catalog:",
    "server": "workspace:*",
    "typescript": "^6",
    "zod": "catalog:"
  }
}
