#!/usr/bin/env bash
# Shim that scrubs disallowed macOS file metadata before invoking the
# real codesign, so ad-hoc signing of electrobun's bundled binaries
# succeeds on macOS Sequoia+ runners without an Apple Developer ID.
#
# Without this, codesign emits:
#   "resource fork, Finder information, or similar detritus not allowed"
#   "Disallowed xattr com.apple.FinderInfo found on .../*.app"
#
# Two sources of detritus:
#   1. xattrs attached during npm/bun extraction (FinderInfo, fpfs#P,
#      quarantine, WhereFroms) — show up on the .app dir and children.
#   2. The UF_HIDDEN BSD file flag carried by electrobun's prebuilt
#      binaries (launcher, bun, libNativeWrapper, etc.).
#
# com.apple.provenance is sticky in Sequoia and codesign tolerates it,
# so we leave it alone.
set -euo pipefail

scrub() {
  local p="$1"
  [[ -e "$p" ]] || return 0
  /usr/bin/xattr -d com.apple.FinderInfo "$p" >/dev/null 2>&1 || true
  /usr/bin/xattr -d 'com.apple.fileprovider.fpfs#P' "$p" >/dev/null 2>&1 || true
  /usr/bin/xattr -d com.apple.metadata:kMDItemWhereFroms "$p" >/dev/null 2>&1 || true
  /usr/bin/xattr -d com.apple.quarantine "$p" >/dev/null 2>&1 || true
  /bin/chflags nohidden "$p" >/dev/null 2>&1 || true
}

target="${@: -1}"

if [[ -e "$target" ]]; then
  scrub "$target"

  # Walk up through every parent, including the enclosing .app bundle —
  # codesign validates xattrs on each ancestor it descends through.
  current="$(dirname "$target")"
  bundle=""
  while [[ -n "$current" && "$current" != "/" ]]; do
    scrub "$current"
    if [[ "$current" == *.app ]]; then
      bundle="$current"
      break
    fi
    current="$(dirname "$current")"
  done

  # Scrub every entry inside the bundle once. Cheap, and avoids surprise
  # detritus on sibling files tripping codesign mid-pass.
  if [[ -n "$bundle" && -d "$bundle" ]]; then
    while IFS= read -r -d '' p; do
      scrub "$p"
    done < <(/usr/bin/find "$bundle" -print0 2>/dev/null)
  fi
fi

exec /usr/bin/codesign "$@"
