{
  "name": "@g-spot/relay-db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit generate && bun run src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "bun run src/migrate.ts"
  },
  "dependencies": {
    "@g-spot/env": "workspace:*",
    "chat": "^4.26.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@g-spot/config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6"
  }
}
